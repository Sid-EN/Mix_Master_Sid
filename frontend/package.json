{
  "name": "mixmaster-frontend",
  "version": "2.7.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "prepare:data": "node scripts/prepare-static-data.mjs && node scripts/build-search-index.mjs",
    "pretype-check": "npm run prepare:data",
    "prebuild": "npm run prepare:data",
    "pretest": "npm run prepare:data",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "build:static": "npm run prepare:data && node scripts/toggle-dynamic-routes.mjs park && (NEXT_PUBLIC_STATIC_MODE=1 next build; node scripts/toggle-dynamic-routes.mjs restore)"
  },
  "dependencies": {
    "@tailwindcss/forms": "0.5.7",
    "@tailwindcss/typography": "0.5.13",
    "autoprefixer": "10.4.19",
    "next": "16.3.4",
    "postcss": "8.5.23",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "tailwindcss": "3.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.4.2",
    "@testing-library/react": "16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "20.12.7",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jest": "29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "typescript": "5.4.5"
  }
}
