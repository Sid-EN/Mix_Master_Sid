# MixMaster Backend 環境變數範本
# 複製此文件為 .env 並填入實際值

DATABASE_URL=postgresql://mixmaster_user:your_password@localhost:5432/mixmaster_db
SECRET_KEY=change-me-in-production-min-32-chars
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:3000"]
DEBUG=true

# 網頁推播（VAPID）。留空則推播功能自動停用。
# 產生金鑰：
#   python3 -c "from py_vapid import Vapid01; from cryptography.hazmat.primitives import serialization as s; \
#   v=Vapid01(); v.generate_keys(); import base64; \
#   b=lambda r: base64.urlsafe_b64encode(r).decode().rstrip('='); \
#   print('VAPID_PRIVATE_KEY='+b(v.private_key.private_numbers().private_value.to_bytes(32,'big'))); \
#   print('VAPID_PUBLIC_KEY='+b(v.public_key.public_bytes(encoding=s.Encoding.X962, format=s.PublicFormat.UncompressedPoint)))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
